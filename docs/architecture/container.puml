@startuml kumelen_container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

!define DEVICONS https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons
!define FONTAWESOME https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/font-awesome-5
!include FONTAWESOME/users.puml

Person(student, "Estudiante UTEM")
Person(serviceCollaborator, "Colaborador", "Servicios Estudiantiles UTEM")

Enterprise_Boundary(UTEMBoundary, "UTEM") {
    System_Boundary(b1, "Sistema Kümelen") {
        Container(iluvatar, "Generación de Publicaciones", "Frontend", "El sitio web que permitirá a los servicios estudiantiles subir contenido al sistema")
        Container(manwe, "App Kümelen", "Frontend", "Aplicación móvil con publicaciones creadas por los servicios estudiantiles")
        Container(elentari, "Backend for Frontend", "Backend", "Servicio backend que construye el contenido de la App")
        Container(aule, "API", "Backend", "Servicio backend que consume y envía información propia del sistema")
        
        ContainerDb(ainulindale, "Base de Datos de Preferencias", "MongoDB", "Almacena las preferencias de contenido de los estudiantes")
    }

    ContainerDb(estudiantesDB, "Base de Datos: Estudiantes", "UTEM", "Repositorio de información de estudiantes UTEM")
}

Container(firebaseNotifications, "Firebase Notifications", "Google", "Herramienta que permite enviar notificaciones a los usuarios de la App")

Rel(serviceCollaborator, iluvatar, "Crea/Actualiza Publicaciones")
Rel_R(student, manwe, "Recibe Publicaciones")
Rel(manwe, elentari, "Consume", "https/443")
Rel(elentari, aule, "Consume", "https/443")
Rel(iluvatar, ainulindale, "Almacena", "tcp")
Rel_R(iluvatar, firebaseNotifications, "Genera notificaciones")
Rel(manwe, firebaseNotifications, "Recibe Notificaciones", "https/443")
Rel_R(aule, ainulindale, "Consume", "tcp")
Rel_L(aule, estudiantesDB, "Consume", "tcp")

@enduml