@startuml aule
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

!define DEVICONS https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons
!define FONTAWESOME https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/font-awesome-5
!include FONTAWESOME/users.puml

Enterprise_Boundary(UTEMBoundary, "UTEM") {
    System_Boundary(kumelenBoundary, "Sistema Kümelen") {
        Container_Boundary(aule, "API") {
            Component(post, "Publicación", "Endpoint", "Servicio que devuelve el detalle de una publicación")
            Component(postsByService, "Publicaciones", "Endpoint", "Servicio que devuelve un listado de publicaciones de un servicio estudiantil")
            Component(postsByCategory, "Publicaciones", "Endpoint", "Servicio que devuelve un listado de publicaciones de una categoria")
        }
        
        Container(elentari, "Backend for Frontend", "Backend", "Servicio backend que construye el contenido de la App")
        ContainerDb(ainulindale, "Base de Datos de Preferencias", "MongoDB", "Almacena las preferencias de contenido de los estudiantes")
    }
}

Rel(elentari, aule, "Recibe información")
Rel(post, ainulindale, "Recibe detalle de una publicación")
Rel(postsByService, ainulindale, "Recibe listado de publicaciones")
Rel(postsByCategory, ainulindale, "Recibe listado de publicaciones")

@enduml