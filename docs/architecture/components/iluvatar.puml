@startuml iluvatar
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

!define DEVICONS https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons
!define FONTAWESOME https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/font-awesome-5
!include FONTAWESOME/users.puml

Person(serviceCollaborator, "Colaborador", "Servicios Estudiantiles UTEM")

System_Boundary(thirdParty, "Herramientas de Terceros") {
    Container_Ext(firebaseNotifications, "Firebase Notifications", "Google", "Herramienta que permite enviar notificaciones a los usuarios de la App")
}

Enterprise_Boundary(UTEMBoundary, "UTEM") {
    System_Boundary(kumelenBoundary, "Sistema Kümelen") {
        Container_Boundary(iluvatar, "Generación de Publicaciones") {
            Component(postScreen, "Publicación", "Pantalla", "Pantalla donde agregar o editar una publicación")
            Component(postsScreen, "Publicaciones", "Pantalla", "Listado de publicaciones creadas")
            Component(serviceScreen, "Servicio Estudiantil", "Pantalla", "Pantalla donde editar información del servicio estudiantil")
            Component(categoryScreen, "Categoría", "Pantalla", "Pantalla donde agregar o editar una categoría")
            Component(categoriesScreen, "Categorías", "Pantalla", "Listado de categorías creadas")
            Component(notificationScreen, "Notificación", "Pantalla", "Pantalla donde agregar o editar una notificación")
            Component(notificationsScreen, "Notificaciones", "Pantalla", "Listado de notificaciones creadas")
            Component(loginScreen, "Login", "Pantalla", "Pantalla de inicio de sesión con credenciales")

            Component(postsEndpoint, "Publicaciones", "Endpoint", "Servicio que lista, añade o actualiza publicaciones")
            Component(categoriesEndpoint, "Categorias", "Endpoint", "Servicio que lista, añade o actualiza categorias")
            Component(servicesEndpoint, "Servicios", "Endpoint", "Servicio que lista, añade o actualiza servicios estudiantiles")
            Component(notificationsEndpoint, "Notificaciones", "Endpoint", "Servicio que lista, añade o actualiza notificaciones")
            Component(loginEndpoint, "Login", "Endpoint", "Servicio que permite el inicio de sesión con credenciales")
        }
        
        ContainerDb(ainulindale, "Base de Datos de Contenido", "Base de Datos", "Almacena las preferencias y contenido del proyecto")
    }
}

Rel_R(serviceCollaborator, iluvatar, "Crea o actualiza")

Rel(postsScreen, postsEndpoint, "Solicita listado")
Rel(postScreen, postsEndpoint, "Envía o actualiza")
Rel(serviceScreen, servicesEndpoint, "Actualiza")
Rel(categoryScreen, categoriesEndpoint, "Envía o actualiza")
Rel(categoriesScreen, categoriesEndpoint, "Solicita listado")
Rel(notificationScreen, notificationsEndpoint, "Envía o actualiza")
Rel(notificationsScreen, notificationsEndpoint, "Solicita listado")
Rel(loginScreen, loginEndpoint, "Envía credenciales")

Rel(notificationsEndpoint, firebaseNotifications, "Envía")

Rel(postsEndpoint, ainulindale, "Solicita, envía o actualiza")
Rel(categoriesEndpoint, ainulindale, "Solicita, envía o actualiza")
Rel(servicesEndpoint, ainulindale, "Solicita, envía o actualiza")
Rel(notificationsEndpoint, ainulindale, "Solicita, envía o actualiza")
Rel(loginEndpoint, ainulindale, "Verifica credenciales")

@enduml