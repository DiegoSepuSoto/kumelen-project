@startuml kumelen_context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(student, "Estudiante UTEM")
Person(serviceCollaborator, "Colaborador", "Servicios Estudiantiles UTEM")

System_Boundary(sistemaKumelen, "Sistema Kümelen") {
    System(kumelen, "Proyecto Kümelen", "Exposición de servicios estudiantiles UTEM")
}

Container(firebaseNotifications, "Firebase Notifications", "Google", "Herramienta que permite enviar notificaciones a los usuarios de la App")
ContainerDb(estudiantesDB, "Base de Datos: Estudiantes", "UTEM", "Repositorio de información de estudiantes UTEM")

Rel(kumelen, firebaseNotifications, "Recibe Notificaciones")
Rel(kumelen, estudiantesDB, "Obtiene", "Información de Estudiantes")
Rel_R(serviceCollaborator, kumelen, "Ingresa", "Publicaciones")
Rel_R(student, kumelen, "Consume", "Publicaciones")

SHOW_LEGEND()
@enduml