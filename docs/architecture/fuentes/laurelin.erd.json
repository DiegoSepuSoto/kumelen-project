  "cards": [
    {
      "dot": "rose",
      "title": "Datos mínimos",
      "items": [
        "Un estudiante es solo correo, nombre, año de ingreso y estado",
        "No se guarda RUT, teléfono ni dirección (Ley 21.719)",
        "El correo va en minúsculas y es único en todo Laurelin"
      ]
    },
    {
      "dot": "cyan",
      "title": "Administradores",
      "items": [
        "super_admin: institution_id nulo y acceso a todo",
        "institution_admin: institution_id obligatorio y solo ve su institución",
        "programs es único por (institution_id, name, level)"
      ]
    },
    {
      "dot": "orange",
      "title": "Auditoría",
      "items": [
