  "cards": [
    { "dot": "rose", "title": "Reglas de acceso", "items": ["Cualquier fallo de token es 401", "403 si el correo no está verificado o no es de un estudiante activo", "503 si Laurelin no responde y no había verificación previa (falla cerrado)"] },
    { "dot": "cyan", "title": "Opcional en local", "items": ["Sin LAURELIN_URL no hay verificación de estudiante", "En producción iluvatar se niega a arrancar así, salvo STUDENT_CHECK_DISABLED=true"] },
