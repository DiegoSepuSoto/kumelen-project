{
  "kind": "collectionType",
  "collectionName": "contactos",
  "info": {
    "singularName": "contacto",
    "pluralName": "contactos",
    "displayName": "Contacto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Tipo": {
      "type": "enumeration",
      "enum": [
        "Web",
        "Correo",
        "Facebook",
        "Twitter",
        "Instagram",
        "TikTok"
      ],
      "required": true
    },
    "Nombre": {
      "type": "string",
      "required": true
    },
    "Link": {
      "type": "string",
      "required": true
    },
    "servicio": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::servicio.servicio",
      "inversedBy": "contactos"
    }
  }
}
