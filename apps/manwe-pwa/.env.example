# Base del BFF (iluvatar). Con `npm run mock` queda en el puerto 8787.
PUBLIC_API_BASE=http://localhost:8787
# Base del CMS para las imágenes relativas del cuerpo de las publicaciones.
PUBLIC_CMS_BASE=http://localhost:8787
# `mock` para desarrollar sin Firebase; `firebase` en producción.
PUBLIC_AUTH_MODE=mock
# Configuración web de Firebase (no es secreta, pero cada entorno usa la suya).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Solo desarrollo y pruebas: host:puerto del emulador de Firebase Auth tal como lo ve el NAVEGADOR
# (por ejemplo localhost:9099). Vacío usa Firebase real. Con el emulador, la clave y el proyecto pueden
# quedar vacíos (se usan demo-api-key y demo-kumelen) o ser cualquier valor; el servidor debe aceptar
# ese proyecto (iluvatar: FIREBASE_PROJECT_ID=demo-kumelen y FIREBASE_AUTH_EMULATOR_HOST).
PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
